// Prisma schema file - defines the structure of the database
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model TrackEvent {
    id          Int               @id @default(autoincrement())
    start       DateTime          @default(now())
    end         DateTime          @default(now())
    name        String
    description String?
    livetimeID  Int?              @unique
    liveTimeEvent LiveTimeEvent?  @relation(fields: [livetimeID], references: [id])
    youtubeID   String?
    visible     Boolean           @default(true)
    cancelled   Boolean           @default(false)
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @default(now()) @updatedAt
}

//Live Time Data represents data scraped from Live Time
model LiveTimeEvent {
    id          Int             @id
    trackEvent  TrackEvent?
    name        String?
    track       String?
    entries     Int?
    drivers     Int?
    laps        Int?
    startedAt   DateTime?
    rounds      LiveTimeEventRound[]
  eventEntries LiveTimeEventEntry[]
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @default(now()) @updatedAt
}

model LiveTimeEventRound {
  roundID         Int             @id
  liveTimeEventID Int
  liveTimeEvent   LiveTimeEvent   @relation(fields: [liveTimeEventID], references: [id])
  name            String
  type            String
  roundNumber     Int?
  heats           LiveTimeEventRoundHeat[]
  results         LiveTimeEventRoundResult[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  @@index([liveTimeEventID])
}

model LiveTimeEventEntry {
  id              Int             @id @default(autoincrement())
  liveTimeEventID Int
  liveTimeEvent   LiveTimeEvent   @relation(fields: [liveTimeEventID], references: [id])
  className       String
  entryNumber     Int
  driverName      String
  fullName        String?
  transponder     String?
  roundHeats      LiveTimeEventRoundHeat[]
  roundResults    LiveTimeEventRoundResult[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  @@index([liveTimeEventID])
  @@index([liveTimeEventID, className])
}

model LiveTimeEventRoundHeat {
  id                Int                @id @default(autoincrement())
  roundID           Int
  round             LiveTimeEventRound @relation(fields: [roundID], references: [roundID])
  liveTimeEventEntryID Int?
  liveTimeEventEntry   LiveTimeEventEntry? @relation(fields: [liveTimeEventEntryID], references: [id])
  raceResultID      Int?
  className         String
  raceNumber        Int
  heatNumber        Int?
  heatTotal         Int?
  startingPosition  Int
  carNumber         Int?
  driverName        String?
  transponder       String?
  seedNumber        Int?
  seedResult        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt

  @@index([roundID])
  @@index([liveTimeEventEntryID])
}

model LiveTimeEventRoundResult {
  id                  Int                @id @default(autoincrement())
  roundID             Int
  round               LiveTimeEventRound @relation(fields: [roundID], references: [roundID])
  liveTimeEventEntryID Int?
  liveTimeEventEntry   LiveTimeEventEntry? @relation(fields: [liveTimeEventEntryID], references: [id])
  raceResultID        Int
  driverLapDataID     Int?
  className           String
  raceNumber          Int?
  finishPosition      Int
  carNumber           Int?
  driverName          String?
  qualifyingPosition  Int?
  laps                Int?
  totalTime           Float?
  behind              String?
  fastestLap          Float?
  fastestLapNumber    Int?
  avgLap              Float?
  avgTop5             Float?
  avgTop10            Float?
  avgTop15            Float?
  top3Consecutive     Float?
  stdDeviation        Float?
  consistency         Float?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt

  @@index([roundID])
  @@index([liveTimeEventEntryID])
  @@index([raceResultID])
}