# Database Configuration
DATABASE_HOST=localhost
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password
DATABASE_NAME=gj_riverside_raceway

# Connection URL for Prisma
# MySQL example:
DATABASE_URL="mysql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST}:3306/${DATABASE_NAME}"

# YouTube live-stream banner
# Create a restricted YouTube Data API v3 key in Google Cloud Console.
YOUTUBE_CHANNEL_ID=your_youtube_channel_id
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key

# PostgreSQL example (comment out MySQL and uncomment this if using PostgreSQL):
# DATABASE_URL="postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST}:5432/${DATABASE_NAME}?schema=public"
